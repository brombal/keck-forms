{
  "name": "keck-forms",
  "version": "3.2.3",
  "description": "Forms with Keck.js",
  "author": "Alex Brombal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brombal/keck-forms.git"
  },
  "scripts": {
    "build": "rm -rf dist && rollup -c",
    "test": "vitest run --coverage",
    "lint": "biome check --write ./src ./test",
    "prepare": "husky"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,jsonc}": [
      "biome check --no-errors-on-unmatched --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@rollup/plugin-typescript": "^12.1.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^16.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup": "^4.60.2",
    "rollup-plugin-dts": "^6.4.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "optionalDependencies": {
    "zod": "^3"
  },
  "dependencies": {
    "keck": "^2.3.2",
    "lodash-es": "^4.17.21",
    "type-fest": "^5.2.0"
  }
}
